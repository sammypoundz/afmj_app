<?php
$host = "localhost";
$db   = "ktomjeuu_jmsdb";
$user = "ktomjeuu_jmsUser";
$pass = "Precious1035@";
$charset = "utf8mb4";

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";

$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
];

try {
    $pdo = new PDO($dsn, $user, $pass, $options);
} catch (\PDOException $e) {
    // Offline/XAMPP fallback: try the default local MySQL account (root, no password)
    try {
        $pdo = new PDO("mysql:host=localhost;dbname=$db;charset=$charset", "root", "", $options);
    } catch (\PDOException $e2) {
        die("Database connection failed.");
    }
}
?>